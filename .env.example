# lambda-auth/.env.example
# ─── DynamoDB ────────────────────────────────────────────────────────────────
USERS_TABLE=my-stack-users
USERS_GSI_USERNAME=username-index
AWS_REGION=us-east-1

# ─── JWT ─────────────────────────────────────────────────────────────────────
# NUNCA coloques el valor real aquí. Configura JWT_SECRET en:
#   - Lambda: Variable de entorno cifrada en la consola, o SSM Parameter Store SecureString.
#   - Local: export JWT_SECRET=$(openssl rand -hex 32)
JWT_SECRET=REEMPLAZAR_CON_SECRETO_GENERADO
JWT_ALGORITHM=HS256
JWT_ISSUER=door-auth
JWT_EXPIRY_SECONDS=900

# ─── CORS ────────────────────────────────────────────────────────────────────
# Producción: dominio de Vercel. Desarrollo: localhost con el puerto de Vite.
ALLOWED_ORIGINS=http://localhost:5173,https://TU-APP.vercel.app